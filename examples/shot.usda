#usda 1.0
#
# A query document. THIS is the durable artifact -- about a kilobyte of
# readable USD. Everything else is derived and can be thrown away.
#
# It names generators and parameters. It does not name geometry, does not name
# a file, and does not say where anything is: the wheels find the chassis hubs
# by contract at compile time.
#
(
    customLayerData = {
        string weft__label    = "sq040_sh0120"
        string weft__context  = "review"
        # Omit weft__baseline to float on @approved -- resolution then mints a
        # baseline and hands it back, so this stays reproducible either way.
    }
)

def Xform "Shot"
{
    def Xform "car_body" (
        prepend apiSchemas = ["WeftInstanceAPI"]
    )
    {
        uniform token  weft:instance:asset = "chassis"
        uniform double weft:param:wheelbase = 2.84
        uniform double weft:param:track     = 1.56
    }

    def Xform "car_wheels" (
        prepend apiSchemas = ["WeftInstanceAPI"]
    )
    {
        uniform token  weft:instance:asset = "wheelset"
        uniform double weft:param:diameter = 0.66
    }
}

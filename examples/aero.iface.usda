#usda 1.0
#
# The aero team. Requires a panel clip; offers nothing.
#
# Note the failure policy: aero is 'substitutable', so a missing provider
# degrades with a warning instead of failing the whole resolution. Partial
# failure is declared, not exceptional.
#
(
    defaultPrim = "aero"
)

def Xform "aero" (
    prepend apiSchemas = ["WeftGeneratorAPI", "WeftRequireAPI:rail"]
)
{
    uniform token weft:require:rail:contract      = "Mount@2"
    uniform token weft:require:rail:role          = "panelClip"
    uniform token weft:require:rail:cardinality   = "one"
    uniform token weft:require:rail:failurePolicy = "substitutable"
}

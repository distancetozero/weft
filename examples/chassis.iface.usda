#usda 1.0
#
# The chassis team's contract surface. Authored USD; no consumer is named
# anywhere, and no consumer names any of these paths.
#
(
    defaultPrim = "chassis"
)

def Xform "chassis" (
    prepend apiSchemas = ["WeftGeneratorAPI"]
)
{
    uniform token weft:costClass = "heavy"

    def Scope "mounts"
    {
        def Xform "hubFL" (
            prepend apiSchemas = ["WeftOfferAPI", "WeftMountAPI", "WeftEnvelopeAPI"]
        )
        {
            uniform token  weft:offer:contract  = "Mount@2"
            uniform token  weft:offer:archetype = "mount"
            uniform token  weft:mount:role      = "wheelHub"
            uniform double weft:envelope:linear = 0.0005
            double3 xformOp:translate = (1.42, 0.31, 0.78)
        }

        def Xform "hubFR" (
            prepend apiSchemas = ["WeftOfferAPI", "WeftMountAPI", "WeftEnvelopeAPI"]
        )
        {
            uniform token  weft:offer:contract  = "Mount@2"
            uniform token  weft:offer:archetype = "mount"
            uniform token  weft:mount:role      = "wheelHub"
            uniform double weft:envelope:linear = 0.0005
            double3 xformOp:translate = (1.42, 0.31, -0.78)
        }

        def Xform "hubRL" (
            prepend apiSchemas = ["WeftOfferAPI", "WeftMountAPI", "WeftEnvelopeAPI"]
        )
        {
            uniform token  weft:offer:contract  = "Mount@2"
            uniform token  weft:offer:archetype = "mount"
            uniform token  weft:mount:role      = "wheelHub"
            uniform double weft:envelope:linear = 0.0005
            double3 xformOp:translate = (-1.42, 0.31, 0.78)
        }

        def Xform "hubRR" (
            prepend apiSchemas = ["WeftOfferAPI", "WeftMountAPI", "WeftEnvelopeAPI"]
        )
        {
            uniform token  weft:offer:contract  = "Mount@2"
            uniform token  weft:offer:archetype = "mount"
            uniform token  weft:mount:role      = "wheelHub"
            uniform double weft:envelope:linear = 0.0005
            double3 xformOp:translate = (-1.42, 0.31, -0.78)
        }

        def Xform "aeroRail" (
            prepend apiSchemas = ["WeftOfferAPI", "WeftMountAPI", "WeftEnvelopeAPI"]
        )
        {
            uniform token  weft:offer:contract  = "Mount@2"
            uniform token  weft:offer:archetype = "mount"
            uniform token  weft:mount:role      = "panelClip"
            uniform double weft:envelope:linear = 0.002
            double3 xformOp:translate = (0.0, 1.05, 0.0)
        }
    }
}

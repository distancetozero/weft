{
  "permissions": {
    "deny": [
      "Edit(.githooks/**)",
      "Write(.githooks/**)",
      "Edit(scripts/start-issue.sh)",
      "Write(scripts/start-issue.sh)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": ".claude/hooks/bd-prime.sh" } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": ".claude/hooks/bd-prime.sh" } ] }
    ]
  }
}

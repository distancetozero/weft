#!/usr/bin/env python3
"""maat-render render <charter> [--templates DIR] [--out DIR] [--version V]"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True  # a tool run from .maat/ must not leave bytecode in the repository
sys.path.insert(0, str(ROOT))

from lib.maat import charter, render, rules_file  # noqa: E402


def plan_or_write(args, c, version: str) -> int:
    repo = Path(args.repo)
    if c.work.tools_dir == ".maat":
        mine = have = "unknown"
        try:
            mine = render.source_version(ROOT)
            have = render.copy_version(repo)
            older = have is not None and render.older_than(mine, have)
        except (KeyError, ValueError):
            print("maat-render: cannot compare maat versions (%s and %s)" % (mine, have),
                  file=sys.stderr)
            return 1
        if older:
            print("maat-render: this maat is %s, older than the copy in .maat/ (%s); run the "
                  "update from the newer maat or from .maat/bin/" % (mine, have), file=sys.stderr)
            return 1
    files, shas, covered = render.render_with_covered(c, Path(args.templates), version, repo,
                                                     source=ROOT)
    copied = render.copy_files(c, ROOT)
    for path, text in copied.items():
        files[path] = text
        shas[path] = render.sha_text(text)
    manifest = render.Manifest.load(repo / render.MANIFEST_PATH)
    piles = render.plan(files, repo, manifest)
    edited = []
    if ROOT.resolve() == (repo / render.COPY_DIR).resolve():
        # Run from the copy, a hand edit to it is also the source: compare with the manifest.
        edited = render.edited_copy(copied, repo, manifest)
        for name in ("new", "unchanged", "maat_changed"):
            setattr(piles, name, [p for p in getattr(piles, name) if p not in edited])
        piles.hand_changed = sorted(set(piles.hand_changed) | set(edited))
    for path, lines in covered.items():
        print("carried over: %s (%d existing lines look covered by the maat section)"
              % (path, len(lines)))
        for line in lines:
            print("  " + line)
    if args.command == "plan":
        for name in ("new", "unchanged", "maat_changed", "hand_changed", "retired"):
            if name == "retired" and not piles.retired:
                continue
            print("%s:" % name)
            for path in getattr(piles, name):
                print(path)
                if name == "hand_changed" and path in render.CARRIED_PATHS:
                    text = (repo / path).read_text(encoding="utf-8", errors="replace")
                    if rules_file.MARKER in text:
                        print("  edits above %s will be replaced; edits below it are kept"
                              % rules_file.MARKER)
                    elif rules_file.HEADING in text:
                        print("  edits above the carried section will be replaced; "
                              "edits below it are kept")
        return 0
    if edited:
        print("maat-render: the copy in .maat/ was edited by hand (%s); restore it by running "
              "the update from the plugin or a maat checkout" % ", ".join(edited), file=sys.stderr)
        return 1
    if args.only:
        unknown = [p for p in args.only if p not in files]
        if unknown:
            print("maat-render: not a rendered path: %s" % ", ".join(unknown), file=sys.stderr)
            return 1
        include = list(args.only)
    else:
        include = piles.new + piles.maat_changed
    # Only a full write retires: a partial write could leave settings calling a forgotten hook.
    retire = [] if args.only else piles.retired
    removed = render.write(files, repo, manifest, include=include, template_shas=shas,
                           version=version, retire=retire)
    for path in include:
        print("wrote %s" % path)
    for path in retire:
        if path in removed:
            print("removed %s" % path)
        else:
            print("retired %s (no longer rendered; delete the file if it is still there)" % path)
    return 0


def main(argv: list) -> int:
    ap = argparse.ArgumentParser(prog="maat-render")
    sub = ap.add_subparsers(dest="command", required=True)
    r = sub.add_parser("render", help="render a charter into project files")
    r.add_argument("charter")
    r.add_argument("--templates", default=str(ROOT / "templates"))
    r.add_argument("--out", help="write files under this directory (default: list paths)")
    r.add_argument("--version", help="maat version for the stamp (default: plugin.json)")
    for name, helptext in (("plan", "show new / unchanged / maat_changed / hand_changed piles"),
                           ("write", "write new and maat-changed files into a repo")):
        q = sub.add_parser(name, help=helptext)
        q.add_argument("charter")
        q.add_argument("--repo", required=True)
        q.add_argument("--templates", default=str(ROOT / "templates"))
        q.add_argument("--version")
        if name == "write":
            q.add_argument("--only", nargs="+", metavar="PATH",
                           help="write exactly these paths, even hand-changed ones")
    args = ap.parse_args(argv)

    version = args.version
    if not version:
        with open(ROOT / ".claude-plugin" / "plugin.json", encoding="utf-8") as f:
            version = json.load(f)["version"]
    try:
        c = charter.load(args.charter)
    except charter.CharterError as e:
        print("maat-render: %s" % e, file=sys.stderr)
        return 1
    if args.command in ("plan", "write"):
        return plan_or_write(args, c, version)
    files = render.render(c, Path(args.templates), version, source=ROOT)
    if not args.out:
        for path in files:
            print(path)
        return 0
    modes = {pub: os.stat(render.template_file(Path(args.templates), c, tpl)).st_mode & 0o777
             for tpl, pub in render.template_paths(c).items()}
    # a path with no template is a skill
    modes = {path: modes.get(path, 0o644) for path in files}
    for path, text in files.items():
        dest = Path(args.out) / path
        dest.parent.mkdir(parents=True, exist_ok=True)
        with open(dest, "w", encoding="utf-8", newline="") as f:
            f.write(text)
        os.chmod(dest, modes[path])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

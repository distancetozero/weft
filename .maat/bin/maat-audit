#!/usr/bin/env python3
"""maat-audit <charter> [--print-expected] [--apply]"""
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True  # a tool run from .maat/ must not leave bytecode in the repository
sys.path.insert(0, str(ROOT))

from lib.maat import charter, ruleset  # noqa: E402


class GhError(Exception):
    pass


def gh_json(args: list):
    p = subprocess.run(["gh", "api"] + args, capture_output=True, text=True)
    if p.returncode != 0:
        detail = (p.stderr.strip().splitlines() or [""])[0]   # one line: the reason, not a dump
        raise GhError("gh api %s failed: %s" % (" ".join(args), detail))
    return json.loads(p.stdout)


def gh_unavailable() -> str:
    """Only what cannot be told from a call: whether gh exists.

    Whether GitHub answers is learnt from the calls the audit makes. A
    separate probe (`gh auth status`, `gh api user`) refuses sessions that
    can make those calls: a cloud session fails the first, and a token
    scoped to the repository fails the second.
    """
    return "" if shutil.which("gh") is not None else "gh is not on PATH"


def find_live(repo: str, name: str):
    listing = gh_json(["repos/%s/rulesets" % repo])
    for item in listing:
        if item.get("name") == name:
            return item["id"], gh_json(["repos/%s/rulesets/%s" % (repo, item["id"])])
    return None, None


def print_expected(c) -> int:
    print(json.dumps(ruleset.expected(c), indent=2))
    print(json.dumps(ruleset.repo_settings(c), indent=2))
    co = ruleset.codeowners(c)
    print("CODEOWNERS: none" if co is None else co, end="" if co else "\n")
    return 0


def apply(c) -> int:
    repo = c.project.repo
    exp = ruleset.expected(c)
    try:
        rid, _ = find_live(repo, exp["name"])
    except GhError as e:
        print("gh unavailable: %s" % e)
        return 2
    if rid is None:
        rs_cmd = ["gh", "api", "-X", "POST", "repos/%s/rulesets" % repo, "--input", "-"]
    else:
        rs_cmd = ["gh", "api", "-X", "PUT", "repos/%s/rulesets/%s" % (repo, rid),
                  "--input", "-"]
    st_cmd = ["gh", "api", "-X", "PATCH", "repos/%s" % repo, "--input", "-"]
    plan = [(rs_cmd, exp), (st_cmd, ruleset.repo_settings(c))]
    for cmd, body in plan:
        print(" ".join(cmd) + "  <<< " + json.dumps(body, sort_keys=True))
    print("type 'yes' to apply:")
    sys.stdout.flush()
    if sys.stdin.readline().rstrip("\n") != "yes":
        print("not applied")
        return 1
    for cmd, body in plan:
        p = subprocess.run(cmd, input=json.dumps(body), capture_output=True, text=True)
        if p.returncode != 0:
            print("maat-audit: %s failed: %s" % (" ".join(cmd), p.stderr.strip()),
                  file=sys.stderr)
            return 1
        print("applied: " + " ".join(cmd))
    return 0


def audit(c) -> int:
    reason = gh_unavailable()
    if reason:
        print("gh unavailable: " + reason)
        return 2
    repo = c.project.repo
    exp = ruleset.expected(c)
    try:
        _, live = find_live(repo, exp["name"])
        settings = gh_json(["repos/%s" % repo])
    except GhError as e:
        print("gh unavailable: %s" % e)
        return 2
    lines = []
    if live is None:
        lines.append('rulesets: expected "%s", live missing' % exp["name"])
    else:
        lines += ruleset.diff(exp, live)
    lines += ruleset.diff_settings(ruleset.repo_settings(c), settings)
    lines += ruleset.diff_default_branch(c, settings)
    for line in lines:
        print(line)
    return 1 if lines else 0


def main(argv: list) -> int:
    ap = argparse.ArgumentParser(prog="maat-audit")
    ap.add_argument("charter")
    ap.add_argument("--print-expected", action="store_true")
    ap.add_argument("--apply", action="store_true")
    args = ap.parse_args(argv)
    try:
        c = charter.load(args.charter)
    except charter.CharterError as e:
        print("maat-audit: %s" % e, file=sys.stderr)
        return 1
    if args.print_expected:
        return print_expected(c)
    if args.apply:
        reason = gh_unavailable()
        if reason:
            print("gh unavailable: " + reason)
            return 2
        return apply(c)
    return audit(c)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
